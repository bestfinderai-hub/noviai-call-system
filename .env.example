# ═══════════════════════════════════════════════════════
# NOVIAI AI-TELEFONIST — ENV TEMPLATE
# Kopiera till .env och fyll i dina värden
# ═══════════════════════════════════════════════════════

# ─── TELNYX ─────────────────────────────────────────────
TELNYX_API_KEY=KEY...
TELNYX_PHONE_NUMBER=+46...
TELNYX_CONNECTION_ID=...
TELNYX_PUBLIC_KEY=                        # Webhooks → Public key (Ed25519, base64)

# ─── GROQ (STT + LLM) ───────────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=qwen/qwen3.8-27b

# ─── PROVIDERS ──────────────────────────────────────────
STT_PROVIDER=groq          # groq | deepgram
LLM_PROVIDER=groq          # groq
TTS_PROVIDER=edge          # edge | elevenlabs | cartesia

# ─── TTS ────────────────────────────────────────────────
TTS_VOICE=sv-SE-SofieNeural
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=
# DEEPGRAM_API_KEY=

# ─── SERVER ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
SERVER_DOMAIN=localhost:3000              # Byt till din Railway/Fly-domän i prod

# ─── ADMIN API ───────────────────────────────────────────
NOVA_ADMIN_TOKEN=                         # Generera: openssl rand -hex 32

# ─── DATABAS ────────────────────────────────────────────
AICHATT_DATABASE_URL=postgresql://...     # Neon PostgreSQL (call reports + analysis)
# NOVA_DATABASE_URL=                      # Separat Neon-projekt för NovAI (optional)

# ─── WEBHOOKS ───────────────────────────────────────────
# NOVA_REPORT_WEBHOOK_URL=               # POST vid samtalets slut (Vapi-format)
# NOVA_REPORT_WEBHOOK_SECRET=            # Läggs som x-novai-secret header
# NOVA_CONVERSATION_WEBHOOK_URL=         # POST per turn (real-time conversation-update)

# ─── SAMTALSBETEENDE ────────────────────────────────────
CALL_LANGUAGE=sv
VAD_SILENCE_MS=400                        # ms tystnad = kunden klar med att tala
MAX_CALL_DURATION=600                     # max sekunder per samtal (hårdgräns)
MAX_TOKENS_LLM=150                        # kortare svar = lägre latens

# First message mode: vem talar först?
# assistant = AI hälsar direkt (default)
# user      = AI väntar på kunden
# model     = AI genererar hälsning dynamiskt med LLM
FIRST_MESSAGE_MODE=assistant

# Idle-timeout: vad händer när kunden är tyst efter AI talat?
IDLE_TIMEOUT_1_MS=10000                   # ms tystnad → skicka idle message 1
IDLE_TIMEOUT_2_MS=8000                    # ms tystnad efter msg 1 → lägg på
IDLE_MESSAGE_1=Är du kvar?
# IDLE_MESSAGE_2=                         # tomt = lägg på direkt

# ─── SYSTEM PROMPT ──────────────────────────────────────
# SYSTEM_PROMPT=Du är Sofia, NovAI telefonist...
# SYSTEM_PROMPT_FILE=./prompts/sofia.md
# Kan ändras live via POST /admin/prompt

# ─── HÄLSNINGSFRAS ───────────────────────────────────────
TTS_GREETING=NovAI, det här är Sofia, hur kan jag hjälpa dig?
# Kan ändras live via POST /admin/greeting

# ─── POST-CALL ANALYS (valfri) ───────────────────────────
# NOVA_ANALYSIS_SCHEMA={"type":"object","properties":{"name":{"type":"string"},"intent":{"type":"string"}}}
# NOVA_SUCCESS_RUBRIC=Kunden fick svar på sin fråga och samtalet avslutades positivt

# ─── VERKTYG (tools) ────────────────────────────────────
# NOVA_TOOLS=[{"name":"lookupOrder","description":"Hämtar orderstatus","url":"https://...","method":"POST","parameters":{"type":"object","properties":{"orderId":{"type":"string","description":"Order-ID"}}}}]
# Kan uppdateras live via POST /admin/tools
