{
  "name": "noviai-call-system",
  "version": "1.0.0",
  "description": "NoviAi Call System — AI-telefoni med Telnyx, Groq Whisper och Edge TTS",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/voicemail.test.js test/providers.test.js test/admin.test.js test/tools.test.js test/analysis.test.js test/sentiment.test.js test/templates.test.js test/filler-filter.test.js",
    "test:voicemail": "node --test test/voicemail.test.js",
    "test:admin": "node --test test/admin.test.js",
    "test:providers": "node --test test/providers.test.js",
    "test:pipeline": "node scripts/test-pipeline.js",
    "test:tts": "node scripts/test-tts.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "alawmulaw": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "ffmpeg-static": "^5.3.0",
    "groq-sdk": "^0.7.0",
    "megajs": "^1.3.10",
    "msedge-tts": "^2.0.8",
    "pg": "^8.23.0",
    "ws": "^8.17.1"
  },
  "allowScripts": {
    "msedge-tts@2.0.8": true,
    "ffmpeg-static@5.3.0": true
  }
}
